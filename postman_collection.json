              "mode": "formdata",
              "formdata": [{"key": "file", "type": "file", "src": []}]
            },
            "url": {
              "raw": "{{baseUrl}}/productor/:id/upload-image",
              "host": ["{{baseUrl}}"],
              "path": ["productor", ":id", "upload-image"],
              "variable": [{"key": "id", "value": ""}]
            }
          }
